{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/cli/index.ts",
        "src/annotate/index.tsx",
        "src/review/index.tsx",
        "src/*/vite.config.ts",
        "src/annotate/dev-mock-api.ts",
        "scripts/shiki-wasm-stub.ts",
        "tests/setup/*.ts",
        "scripts/**/*.mjs",
        "scripts/dast/target.ts",
        "**/*.test.{ts,tsx}",
        "src/shared/**/*.test-d.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "scripts/**/*.{ts,mjs}",
        "tests/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@happy-dom/global-registrator"
      ]
    }
  }
}
