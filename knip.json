{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": [
    "taskkill.exe"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/shiki-wasm-stub.ts",
        "tests/setup/*.ts",
        "scripts/**/*.mjs",
        "scripts/dast/target.ts"
      ],
      "project": [
        "scripts/**/*.{ts,mjs}",
        "tests/**/*.{ts,tsx}"
      ]
    },
    "apps/hook": {
      "entry": [
        "dev-mock-api.ts",
        "**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx,css}"
      ]
    },
    "apps/review": {
      "project": [
        "**/*.{ts,tsx,css}"
      ]
    },
    "packages/core": {
      "entry": [
        "**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ]
    },
    "packages/shared": {
      "entry": [
        "**/*.test.{ts,tsx}",
        "**/*.test-d.ts"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ]
    },
    "packages/server": {
      "entry": [
        "**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ]
    },
    "packages/ui": {
      "entry": [
        "styles-entry.css",
        "build-stubs/*.css",
        "test-consumer/*.tsx",
        "**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx,css}"
      ],
      "ignoreDependencies": [
        "@happy-dom/global-registrator"
      ]
    },
    "packages/editor": {
      "entry": [
        "**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx,css}"
      ]
    },
    "packages/review-editor": {
      "entry": [
        "**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx,css}"
      ]
    }
  }
}
