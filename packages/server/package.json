{
  "name": "@hypermark/server",
  "version": "0.27.12",
  "private": true,
  "description": "Shared server implementation for Hypermark plugins",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./review": "./review.ts",
    "./annotate": "./annotate.ts",
    "./browser": "./browser.ts",
    "./storage": "./storage.ts",
    "./git": "./git.ts",
    "./vcs": "./vcs.ts",
    "./repo": "./repo.ts",
    "./uninstall": "./uninstall.ts",
    "./sessions": "./sessions.ts",
    "./project": "./project.ts",
    "./html-assets": "./html-assets.ts"
  },
  "files": [
    "*.ts",
    "*.mjs"
  ],
  "dependencies": {
    "@pierre/diffs": "1.4.1",
    "@hypermark/shared": "workspace:*"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  }
}
