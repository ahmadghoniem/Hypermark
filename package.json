{
  "name": "hypermark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Annotate documents and Claude's messages, review code diffs in the browser, and send feedback to Claude Code.",
  "author": "ahmadghoniem",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadghoniem/Hypermark.git"
  },
  "homepage": "https://github.com/ahmadghoniem/Hypermark",
  "bugs": {
    "url": "https://github.com/ahmadghoniem/Hypermark/issues"
  },
  "scripts": {
    "dev:annotate": "vite --config src/annotate/vite.config.ts",
    "dev:review": "vite --config src/review/vite.config.ts",
    "build:annotate": "vite build --config src/annotate/vite.config.ts",
    "build:review": "vite build --config src/review/vite.config.ts",
    "build": "bun run build:review && bun run build:annotate",
    "check:release-version": "node scripts/check-release-version.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p src/shared/tsconfig.json && tsc --noEmit -p src/server/tsconfig.json && tsc --noEmit -p src/ui/tsconfig.json",
    "typecheck:editors": "tsc --noEmit -p src/annotate/tsconfig.json && tsc --noEmit -p src/review/tsconfig.json",
    "lint:tw": "eslint src/ui src/annotate src/review --max-warnings 0",
    "lint:tw:fix": "eslint src/ui src/annotate src/review --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist-mono": "5.2.7",
    "@fontsource-variable/inter": "^5.2.8",
    "@joplin/turndown-plugin-gfm": "^1.0.64",
    "@pierre/diffs": "1.4.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@plannotator/web-highlighter": "^0.8.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-table": "^8.21.3",
    "@untitledui/icons": "^0.0.23",
    "@viz-js/viz": "^3.25.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.4",
    "dompurify": "^3.3.3",
    "katex": "^0.16.47",
    "lucide-react": "^1.52.0",
    "marked": "^17.0.6",
    "mermaid": "^11.12.2",
    "motion": "^12",
    "parse5": "^7.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.1",
    "@types/bun": "^1.2.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "bun-types": "^1.3.11",
    "eslint": "^10.10.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
