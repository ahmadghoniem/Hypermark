{
  "name": "hypermark",
  "version": "0.27.12",
  "private": true,
  "description": "Interactive Plan Review for Claude Code - annotate plans visually, share with team, automatically send feedback",
  "author": "ahmadghoniem",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadghoniem/Hypermark.git"
  },
  "homepage": "https://github.com/ahmadghoniem/Hypermark",
  "bugs": {
    "url": "https://github.com/ahmadghoniem/Hypermark/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:hook": "bun run --cwd apps/hook dev",
    "dev:review": "bun run --cwd apps/review dev",
    "build:review": "bun run --cwd apps/review build",
    "build:hook": "bun run --cwd apps/hook build",
    "build": "bun run build:review && bun run build:hook",
    "check:release-version": "node scripts/check-release-version.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/server/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.strict-consumer.json",
    "typecheck:editors": "tsc --noEmit -p packages/editor/tsconfig.json && tsc --noEmit -p packages/review-editor/tsconfig.json",
    "build:ui-css": "bun run --cwd packages/ui build:css"
  },
  "dependencies": {
    "@pierre/diffs": "1.4.1",
    "diff": "^8.0.4",
    "dockview-react": "^5.2.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/turndown": "^5.0.6",
    "bun-types": "^1.3.11",
    "typescript": "~5.8.2"
  }
}
